# The report site's server: nginx with deploy/nginx.conf, the built site
# mounted at /site (`abt-report build --out` writes it; a rebuild replaces
# the files in place, nginx serves whatever is there).
#
#   docker build -f deploy/Dockerfile.report -t absolute/report .
#   docker run --rm -p 127.0.0.1:8080:8080 -v /var/lib/absolute/site:/site:ro absolute/report
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/conf.d/default.conf.orig && mkdir -p /site
VOLUME ["/site"]
EXPOSE 8080
