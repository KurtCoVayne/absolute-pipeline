# The harness image (PL-6.7, PL-D3): absolute/harness:<skills_version>. Built from
# the repository root:
#   docker build -f deploy/Dockerfile.harness -t absolute/harness:$(git rev-parse --short HEAD:agents-skills) .
# No secrets: the proxy holds the OpenAI key, the job directory holds the token.
# The skills under /opt/skills are the fallback; the job directory's copy wins.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    JOB_DIR=/job

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin harness

WORKDIR /opt/harness
COPY agents-harness/requirements.txt ./requirements.txt
RUN pip install --require-hashes --no-deps -r requirements.txt

COPY agents-harness/agents_harness ./agents_harness
COPY agents-skills/skills /opt/skills

USER harness
ENTRYPOINT ["python", "-m", "agents_harness"]
